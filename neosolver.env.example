# NeoSolver configuration — copy to ./neosolver.env and fill in the blanks.
#
#   cp neosolver.env.example neosolver.env
#   ./start.sh
#
# ./start.sh loads ./neosolver.env first and ./.env second (if present).
# Every value below is read from the environment by the service itself.
#
# The three values marked REQUIRED have no default on purpose: you must supply
# your own provider endpoint, model id and API key.

# ---------------------------------------------------------------------------
# Bind
# ---------------------------------------------------------------------------
# 0.0.0.0 so a reverse proxy on another machine (or another container) can reach
# it. Use 127.0.0.1 only when the proxy runs on this same host in the same
# network namespace.
NEOSOLVER_HOST=0.0.0.0
NEOSOLVER_PORT=8787

# ---------------------------------------------------------------------------
# Client auth
# ---------------------------------------------------------------------------
# REQUIRED: a SHORT token that YOU choose. It is typed by hand on every
# challenge, so keep it short and memorable — but not guessable if the service is
# reachable from the internet, because anyone who has it can spend your provider
# credits.
#   NEOSOLVER_TOKEN=myteam7
NEOSOLVER_TOKEN=

# Set to 1 to disable client auth entirely. Only safe when the reverse proxy in
# front already enforces access control.
NEOSOLVER_ALLOW_ANON=0

# ---------------------------------------------------------------------------
# Model provider — any OpenAI-compatible POST {base}/chat/completions
# ---------------------------------------------------------------------------
# REQUIRED: your provider's endpoint. Accepted forms:
#   https://api.example.com                 (a bare domain works too)
#   https://api.example.com/v1
#   https://api.example.com/v1/chat/completions
NEOSOLVER_PROVIDER_URL=

# REQUIRED: the exact model id your provider expects, e.g. the id shown in their
# dashboard or model list. This project does not assume a vendor.
NEOSOLVER_MODEL=

# Optional reasoning effort for reasoning models (e.g. low, medium, high).
#NEOSOLVER_REASONING_EFFORT=medium

# Optional fallback model, used for exactly ONE extra attempt when the primary
# times out, is rate-limited, returns a 5xx, or answers with something
# unparseable. A credential/permission failure never falls back (that is an
# operator problem, and silently spending a second model would hide it).
# Leave empty to disable.
NEOSOLVER_FALLBACK_MODEL=

# REQUIRED: your provider's API key. Either set it here, or point at a file that
# contains it (useful when the key comes from a secret mount):
#NEOSOLVER_PROVIDER_KEY=
#NEOSOLVER_PROVIDER_KEY_FILE=/path/to/keyfile

# Optional comma-separated allowlist. When set, ?model= outside the list is a 400.
#NEOSOLVER_ALLOWED_MODELS=

# ---------------------------------------------------------------------------
# Limits and behaviour (defaults shown — all optional)
# ---------------------------------------------------------------------------
# Maximum request body (the raw test file), in bytes.
NEOSOLVER_MAX_BODY=1048576

# Per provider call.
NEOSOLVER_TIMEOUT_MS=120000

# Concurrency. Solves hold an upstream socket for the whole model call, so the
# burst is bounded: requests beyond MAX_CONCURRENCY wait in FIFO order, and
# beyond QUEUE_LIMIT they are refused with 503 + Retry-After instead of hanging.
# QUEUE_LIMIT=0 refuses as soon as the slots are taken.
NEOSOLVER_MAX_CONCURRENCY=8
NEOSOLVER_QUEUE_LIMIT=32

# While a streamed solve runs, a shell comment is written this often so a proxy in
# front (one that drops an origin which goes silent) cannot cut the connection.
# 0 disables it.
NEOSOLVER_HEARTBEAT_MS=15000

# Maximum number of files the model may return, and their total size.
NEOSOLVER_MAX_FILES=64
NEOSOLVER_MAX_TOTAL_BYTES=4194304

# Test command baked into the default `sh` response. Override per request with
# ?test=<cmd>; skip it entirely with ?test=none.
NEOSOLVER_TEST_COMMAND=npm test

# error | warn | info | debug
NEOSOLVER_LOG_LEVEL=info

# The service owns its log file: it appends there and rotates to <file>.1 once the
# file would exceed NEOSOLVER_LOG_MAX_BYTES, so an unattended run cannot fill the
# disk. Leave NEOSOLVER_LOG_FILE empty to log to stderr only (stderr is also
# echoed live when attached to a terminal).
NEOSOLVER_LOG_FILE=logs/neosolver.log
NEOSOLVER_LOG_MAX_BYTES=5242880
